          ]
        }
      ],
      "energia": [
        {
          "titulo": "Conservación local de energía",
          "ecuacion": "\\frac{\\partial(\\rho e)}{\\partial t}=-\\nabla\\cdot(\\rho e\\mathbf v)-\\nabla\\cdot\\mathbf q+\\nabla\\cdot(\\boldsymbol\\sigma\\cdot\\mathbf v)+\\rho\\mathbf b\\cdot\\mathbf v+r_v",
          "relaciones": [
            "e=u+\\frac{\\mathbf v\\cdot\\mathbf v}{2}",
            "\\mathbf q:\\ \\text{flujo energético no convectivo}"
          ]
        },
        {
          "titulo": "Integrar sobre V(t) y aplicar Gauss",
          "ecuacion": "\\int_{V(t)}\\frac{\\partial(\\rho e)}{\\partial t}\\,dV=-\\oint_{\\partial V(t)}\\rho e(\\mathbf v)\\cdot\\mathbf n\\,dA-\\oint_{\\partial V(t)}\\mathbf q\\cdot\\mathbf n\\,dA+\\oint_{\\partial V(t)}(\\boldsymbol\\sigma\\cdot\\mathbf v)\\cdot\\mathbf n\\,dA+\\int_{V(t)}\\rho\\mathbf b\\cdot\\mathbf v\\,dV+\\int_{V(t)}r_v\\,dV",
          "relaciones": [
            "\\int_{V(t)}\\nabla\\cdot\\mathbf F\\,dV=\\oint_{\\partial V(t)}\\mathbf F\\cdot\\mathbf n\\,dA"
          ]
        },
        {
          "titulo": "Aplicar el teorema de transporte de Reynolds",
          "ecuacion": "\\frac{dE}{dt}=-\\oint_{\\partial V(t)}\\rho e(\\mathbf v)\\cdot\\mathbf n\\,dA-\\oint_{\\partial V(t)}\\mathbf q\\cdot\\mathbf n\\,dA+\\oint_{\\partial V(t)}(\\boldsymbol\\sigma\\cdot\\mathbf v)\\cdot\\mathbf n\\,dA+\\int_{V(t)}\\rho\\mathbf b\\cdot\\mathbf v\\,dV+\\int_{V(t)}r_v\\,dV",
          "relaciones": [
            "\\frac{d}{dt}\\int_{V(t)}\\rho e\\,dV=\\int_{V(t)}\\frac{\\partial(\\rho e)}{\\partial t}\\,dV+\\oint_{\\partial V(t)}\\rho e\\mathbf v_b\\cdot\\mathbf n\\,dA",
            "E(t)=\\int_{V(t)}\\rho e\\,dV"
          ]
        },
        {
          "titulo": "Separar presión y viscosidad",
          "ecuacion": "\\frac{dE}{dt}=-\\oint_{\\partial V(t)}\\rho e(\\mathbf v)\\cdot\\mathbf n\\,dA-\\oint_{\\partial V(t)}\\mathbf q\\cdot\\mathbf n\\,dA-\\oint_{\\partial V(t)}p\\mathbf v\\cdot\\mathbf n\\,dA+\\oint_{\\partial V(t)}(\\boldsymbol\\tau\\cdot\\mathbf v)\\cdot\\mathbf n\\,dA+\\int_{V(t)}\\rho\\mathbf b\\cdot\\mathbf v\\,dV+\\int_{V(t)}r_v\\,dV",
          "relaciones": [
            "\\boldsymbol\\sigma=-p\\mathbf I+\\boldsymbol\\tau"
          ]
        },
        {
          "titulo": "Particionar la frontera en puertos y superficie restante",
          "ecuacion": "\\frac{dE}{dt}=\\dot Q+\\dot W_\\tau+\\dot W_{\\mathbf b}+R",
          "relaciones": [
            "\\partial V=\\left(\\bigcup_p A_p\\right)\\cup S_{\\mathrm{resto}},\\quad A_p\\cap A_q=\\varnothing\\ (p\\ne q)",
            "\\dot m_p=\\varepsilon_p\\int_{A_p}\\rho(\\mathbf v-\\mathbf v_b)\\cdot\\mathbf n\\,dA,\\quad\\varepsilon_{\\mathrm{ent}}=-1,\\ \\varepsilon_{\\mathrm{sal}}=1",
            "\\dot m_p\\bar h_p=\\varepsilon_p\\int_{A_p}\\rho h(\\mathbf v-\\mathbf v_b)\\cdot\\mathbf n\\,dA"
          ]
        },
        {
          "titulo": "Despreciar energía cinética",
          "ecuacion": "\\frac{dU}{dt}=\\dot Q+\\dot W_\\tau+\\dot W_{\\mathbf b}+R",
          "relaciones": [
            "e_c\\simeq0"
          ]
        },
        {
          "titulo": "Retirar trabajo viscoso",
          "ecuacion": "\\frac{dU}{dt}=\\dot Q+\\dot W_{\\mathbf b}+R",
          "relaciones": [
            "\\dot W_\\tau=0"
          ]
        },
        {
          "titulo": "Retirar trabajo de fuerzas de volumen",
          "ecuacion": "\\frac{dU}{dt}=\\dot Q+R",
          "relaciones": [
            "\\dot W_{\\mathbf b}=0"
          ]
        },
        {
          "titulo": "Retirar aportes volumétricos",
          "ecuacion": "\\frac{dU}{dt}=\\dot Q",
          "relaciones": [
            "R=0"
          ]
        },
        {
          "titulo": "Declarar temperatura y energía específica uniformes",
          "ecuacion": "\\frac{dU}{dt}=\\dot Q",
          "relaciones": [
            "T(\\mathbf x,t)=T(t),\\quad u(\\mathbf x,t)=\\bar u(t),\\quad U=m\\bar u"
          ]
        }
      ]
