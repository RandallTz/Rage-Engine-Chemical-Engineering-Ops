    "derivacion": {
      "materia": [
        {
          "titulo": "Conservación local",
          "ecuaciones": [
            "\\frac{\\partial\\rho_i}{\\partial t}=-\\nabla\\!\\cdot(\\rho_i\\mathbf v)-\\nabla\\!\\cdot\\mathbf j_i+\\gamma_i(\\mathbf x,t)-\\chi_i(\\mathbf x,t)"
