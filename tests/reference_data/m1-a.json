                    "generacionUniforme": false,
                    "consumoUniforme": false
                  }
                }
              },
              {
                "id": "step-2",
                "title": "Fixed control-volume boundary",
                "changes": {
                  "fija": true
                }
              },
              {
                "id": "step-3",
                "title": "Integrate over the control volume \u00b7 Gauss and Reynolds",
                "changes": {
                  "vista": "integral"
                }
              },
              {
                "id": "step-4",
                "title": "Define component inventories and partition the boundary into streams",
                "changes": {
                  "vista": "cantidad"
                }
              },
              {
                "id": "step-5",
                "title": "Impermeable boundary outside the declared streams",
                "changes": {
                  "restoImpermeable": true
                }
              }
            ]
          }
        }
      },
      "energyDerivation": {
        "format": "rage.energy-derivation",
        "version": 1,
        "volumes": {
          "mixture": {
            "origin": "reviewed_rebuild",
            "operations": [
              {
                "id": "step-1",
                "title": "Separate pressure and viscous stress",
                "changes": {
                  "separarPresion": true
                }
              },
              {
                "id": "step-2",
                "title": "Negligible kinetic energy",
                "changes": {
                  "sinCinetica": true
                }
              },
              {
                "id": "step-3",
                "title": "Negligible viscous work",
                "changes": {
                  "sinTrabajoViscoso": true
                }
              },
              {
                "id": "step-4",
                "title": "No body-force work",
                "changes": {
                  "sinFuerzasVolumen": true
                }
              },
              {
                "id": "step-5",
                "title": "No volumetric energy source",
                "changes": {
                  "sinFuenteVolumetrica": true
                }
              },
              {
                "id": "step-6",
                "title": "Integrate the local first law and apply Gauss",
                "changes": {
                  "forma": "integrada"
                }
              },
              {
                "id": "step-7",
                "title": "Apply Reynolds transport theorem",
                "changes": {
                  "forma": "integral"
                }
              },
              {
                "id": "step-8",
                "title": "Define total energy and oriented stream contributions",
                "changes": {
                  "forma": "total"
                }
              },
              {
                "id": "step-9",
                "title": "Uniform temperature and specific internal energy",
                "changes": {
                  "uniforme": true
                }
              },
              {
                "id": "step-10",
                "title": "Collect flow work into enthalpy",
                "changes": {
                  "entalpia": true
                }
              }
            ]
          }
        }
      },
      "thermodynamicDerivation": {
        "format": "rage.thermodynamic-derivation",
        "version": 1,
        "volumes": {
          "mixture": {
            "origin": "reviewed_rebuild",
            "operations": [
              {
                "id": "step-1",
                "title": "Assume a single phase",
                "changes": {
                  "monofasico": true
                }
              },
              {
                "id": "step-2",
                "title": "Keep the initial phase set",
                "changes": {
                  "sinCambioFase": true
                }
              },
              {
                "id": "step-3",
                "title": "Declare a linear specific internal-energy law",
                "changes": {
