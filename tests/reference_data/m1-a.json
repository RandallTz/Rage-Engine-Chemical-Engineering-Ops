      "materialDerivation": {
        "format": "rage.material-derivation",
        "version": 1,
        "volumes": {
          "mixture": {
            "origin": "reviewed_rebuild",
            "operations": [
              {
                "id": "step-1",
                "title": "No chemical generation or consumption",
                "changes": {
                  "campo": {
                    "sinReaccion": true,
                    "sinDifusion": false,
                    "sinConveccion": false,
                    "estacionario": false,
